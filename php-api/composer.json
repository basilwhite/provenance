{
    "name": "basilwhite/provenance-php",
    "description": "PHP port of the Provenance ledger-backed AI validator reputation system (production deployment target for Network Solutions shared hosting).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-sodium": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "kornrunner/keccak": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Provenance\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Provenance\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1"
        }
    }
}
